# Each workspace has its own .env. Set only the keys used by its settings.yaml.
# Process environment variables take precedence. Never commit real tokens.
# OpenAI chat and/or embeddings:
# OPENAI_API_KEY=your-openai-api-key
# Z.ai chat:
# ZAI_API_KEY=your-zai-api-key
# DeepSeek chat:
# DEEPSEEK_API_KEY=your-deepseek-api-key
# Local OpenClaw (default): read gateway.auth.token at runtime.
# OPENCLAW_CONFIG=~/.openclaw/openclaw.json
# Optional explicit OpenClaw token (takes precedence over the config file):
# GRAPHRAG_API_KEY=your-gateway-token
# For separate compatible endpoints, use --api-key-env / --embedding-api-key-env.

# App login: export GRAPHRAG_AUTH_USERS_JSON in the application process environment.
# It maps usernames to password hashes generated by ir_graphrag.auth.hash_password.
# Workspace .env files do not configure UI login; see README. Never commit real account settings.
